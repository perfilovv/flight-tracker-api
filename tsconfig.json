{
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  }
}

